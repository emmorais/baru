\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Milliseconds per encrypted MedMNIST diagnosis, median of three repeats; winner in bold. \emph  {Cold} charges Falcon for preprocessing on the critical path; \emph  {warm} generates it per MPC segment beforehand and reports the online cost. Garbled circuits have no query-independent phase to hoist, so their row serves both. Cold crossover between $20$ and \SI {30}{\mega \bit \per \second } at RTT 0 and below \SI {10}{\mega \bit \per \second } at \SI {20}{\milli \second }; warm, between $100$ and \SI {1000}{\mega \bit \per \second } and between $30$ and \SI {40}{\mega \bit \per \second }. Higher round-trip time moves each boundary \emph  {down}; hoisting preprocessing moves it sharply \emph  {up}. Cells within ${\approx }\SI {13}{\percent }$ are unresolved (\cref  {sec:threats}): at RTT 0 the \SI {30}{\mega \bit \per \second } cold cell and the \SI {100}{\mega \bit \per \second } warm cell are ties, so each boundary is a band.}}{56}{table.17}\protected@file@percent }
\newlabel{tab:crossover}{{17}{56}{Milliseconds per encrypted MedMNIST diagnosis, median of three repeats; winner in bold. \emph {Cold} charges Falcon for preprocessing on the critical path; \emph {warm} generates it per MPC segment beforehand and reports the online cost. Garbled circuits have no query-independent phase to hoist, so their row serves both. Cold crossover between $20$ and \SI {30}{\mega \bit \per \second } at RTT 0 and below \SI {10}{\mega \bit \per \second } at \SI {20}{\milli \second }; warm, between $100$ and \SI {1000}{\mega \bit \per \second } and between $30$ and \SI {40}{\mega \bit \per \second }. Higher round-trip time moves each boundary \emph {down}; hoisting preprocessing moves it sharply \emph {up}. Cells within ${\approx }\SI {13}{\percent }$ are unresolved (\cref {sec:threats}): at RTT 0 the \SI {30}{\mega \bit \per \second } cold cell and the \SI {100}{\mega \bit \per \second } warm cell are ties, so each boundary is a band}{table.17}{}}
\newlabel{tab:crossover@cref}{{[table][17][]17}{[1][56][]56}{}{}{}}
