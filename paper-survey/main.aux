\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces One network, $x(16) \to \text  {dense}(8) \to \ensuremath  {\mathrm  {ReLU}}\to \text  {dense}(4) \to \max $ with secret weights, both routes over the same transport and both checked against the plaintext reference. The gadget route is written by an expert who called the batched primitives deliberately; the compiled route is scalar source with no batching hint. \emph  {Calls} counts backend primitives, \emph  {waits} counts the times a party blocked for a peer. The last rung is a protocol assignment in place of a compiler pass, so the hand-written route is given the same assignment in the second row --- the two rows in bold are the comparison that means something. Bytes are one run and are stable; the millisecond columns carry the harness's run-to-run variance of roughly \SI {13}{\percent }. $^\dagger $Waits carry a $\pm 1$ of their own, and the marker is on this row because it is where we first saw it: over four repetitions at RTT~0 it read \num {32}, \num {33}, \num {32}, \num {33}, while every other row was identical in all four. A run that also swept RTT~20 then moved three rows by one count, so the jitter is not confined to this row --- it is a property of the counter. A receive that finds its message already delivered does not block, so the quantity is how many times a party \emph  {had} to stop, and that depends on thread interleaving, which the network profile itself perturbs. Read every wait figure here as $\pm 1$.}}{57}{table.9}\protected@file@percent }
\newlabel{tab:handvscompiled}{{9}{57}{One network, $x(16) \to \text {dense}(8) \to \ReLU \to \text {dense}(4) \to \max $ with secret weights, both routes over the same transport and both checked against the plaintext reference. The gadget route is written by an expert who called the batched primitives deliberately; the compiled route is scalar source with no batching hint. \emph {Calls} counts backend primitives, \emph {waits} counts the times a party blocked for a peer. The last rung is a protocol assignment in place of a compiler pass, so the hand-written route is given the same assignment in the second row --- the two rows in bold are the comparison that means something. Bytes are one run and are stable; the millisecond columns carry the harness's run-to-run variance of roughly \SI {13}{\percent }. $^\dagger $Waits carry a $\pm 1$ of their own, and the marker is on this row because it is where we first saw it: over four repetitions at RTT~0 it read \num {32}, \num {33}, \num {32}, \num {33}, while every other row was identical in all four. A run that also swept RTT~20 then moved three rows by one count, so the jitter is not confined to this row --- it is a property of the counter. A receive that finds its message already delivered does not block, so the quantity is how many times a party \emph {had} to stop, and that depends on thread interleaving, which the network profile itself perturbs. Read every wait figure here as $\pm 1$}{table.9}{}}
\newlabel{tab:handvscompiled@cref}{{[table][9][]9}{[1][56][]57}{}{}{}}
