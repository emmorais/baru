@InProceedings{Wang2023,
author="Wang, Yi
and Chen, Rongmao
and Huang, Xinyi
and Yung, Moti",
editor="Guo, Jian
and Steinfeld, Ron",
title="Sender-Anamorphic Encryption Reformulated: Achieving Robust and Generic Constructions",
booktitle="Advances in Cryptology -- ASIACRYPT 2023",
year="2023",
publisher="Springer Nature Singapore",
address="Singapore",
pages="135--167",
abstract="Motivated by the violation of two fundamental assumptions in secure communication - receiver-privacy and sender-freedom - by a certain entity referred to as ``the dictator'', Persiano et al. introduced the concept of Anamorphic Encryption (AME) for public key cryptosystems (EUROCRYPT 2022). Specifically, they presented receiver/sender-AME, directly tailored to scenarios where receiver privacy and sender freedom assumptions are compromised, respectively. In receiver-AME, entities share a double key to communicate in anamorphic fashion, raising concerns about the online distribution of the double key without detection by the dictator. The sender-AME with no shared secret is a potential candidate for key distribution. However, the only such known schemes (i.e., LWE and Dual LWE encryptions) suffer from an intrinsic limitation and cannot achieve reliable distribution.",
isbn="978-981-99-8736-8"
}

@InProceedings{Wang2024,
author="Wang, Weihao
and Han, Shuai
and Liu, Shengli",
editor="Chung, Kai-Min
and Sasaki, Yu",
title="Anamorphic Authenticated Key Exchange: Double Key Distribution Under Surveillance",
booktitle="Advances in Cryptology -- ASIACRYPT 2024",
year="2025",
publisher="Springer Nature Singapore",
address="Singapore",
pages="168--200",
abstract="Anamorphic encryptions and anamorphic signatures assume a double key pre-shared between two parties so as to enable the transmission of covert messages. How to securely and efficiently distribute a double key under the dictator's surveillance is a central problem for anamorphic cryptography, especially when the users are forced to surrender their long-term secret keys or even the randomness used in the algorithms to the dictator.",
isbn="978-981-96-0935-2"
}

