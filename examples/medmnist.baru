; MedMNIST private diagnosis, written in Baru.
;
; Run it:
;   baru run examples/medmnist.baru --dataset pneumonia --images 1            ; plaintext
;   baru run examples/medmnist.baru --dataset pneumonia --images 1 --mpc      ; 3-party MPC
;
; The same source text evaluates on the plain interpreter and on the MPC
; backend. Nothing below branches on the backend: every operator dispatches on
; the runtime type of its operands, so `vmul`, `vmax`, `vashr` and `matvec` are
; local integer arithmetic when handed Nums and ABY3 protocol steps when handed
; Shares. The one place privacy is chosen is `load-input`, near the bottom.
;
; PRIVATE is injected by `baru run`:
;   0  plaintext — no sharing, no encryption. The cost of the computation alone.
;   1  the IMAGE is secret-shared, the model is public. This is the threat model
;      most 2-party private-inference papers actually measure: the server
;      evaluates on plaintext weights. Linear layers are then share×public,
;      which ABY3 does LOCALLY — so all communication here is comparisons.
;   2  the image AND every weight are secret-shared. This is the model
;      `bench-medmnist` measures (there, ciphertext×ciphertext), where the only
;      value that ever leaves the cryptographic domain is the class index.
;
; ─── Written a layer at a time, on purpose ──────────────────────────────────
;
; Everything below operates on WHOLE LAYERS through the vector primitives
; (`vmul`, `vlt`, `vmax`, `vashr`, `vslice`, LANGUAGE.md §5.2c), never on one
; activation at a time. That is not a style preference — it is the difference
; between one communication round per layer and one per element. §6.2: "cost is
; rounds, not operations". The first version of this file was written with
; scalar `>` and `ash-right` and cost 864 361 messages for one diagnosis; the
; arithmetic was identical.
;
; A convolution is therefore expressed as a **sum of scaled strided views**
; rather than as a loop over sliding windows: for each of the `in_c*k*k` taps,
; take the `oh x ow` view of the input at that tap's offset, scale it by that
; tap's weight, accumulate. The views are the same for every output channel, so
; they are computed once per layer. This is the same reshaping NumPy code does,
; and for the same reason.

; ─── the model, as ordinary Lisp data ────────────────────────────────────────
; Layout is documented in src/interpreter/dataset_builtins.rs. Named here so no
; call site below indexes the list by hand.
(define (model-d m)        (list-ref m 0))
(define (model-in-c m)     (list-ref m 1))
(define (model-shift m)    (list-ref m 2))
(define (model-nclasses m) (list-ref m 3))
(define (model-conv1 m)    (list-ref m 4))
(define (model-extra m)    (list-ref m 5))
(define (model-hidden m)   (list-ref m 6))
(define (model-dense-w m)  (list-ref m 7))
(define (model-dense-b m)  (list-ref m 8))
; The share width for this model, calibrated by the trainer from the worst
; activation it actually saw — NOT the command line. Pneumonia is exact at 20
; bits and wrong at 19, and organa needs more than pneumonia; a hand-picked
; width is a silent wrong answer on the dataset it does not fit. `a2b` cost
; scales with it, so this is also the single biggest lever on the private run.
(define (model-nbits m)    (list-ref m 9))

(define (conv-kernels c) (list-ref c 0))
(define (conv-bias c)    (list-ref c 1))
(define (conv-k c)       (list-ref c 2))

(define (xconv-kernels c) (list-ref c 0))
(define (xconv-bias c)    (list-ref c 1))
(define (xconv-in-c c)    (list-ref c 2))
(define (xconv-in-h c)    (list-ref c 3))
(define (xconv-in-w c)    (list-ref c 4))
(define (xconv-k c)       (list-ref c 5))

(define (dense-w l) (list-ref l 0))
(define (dense-b l) (list-ref l 1))

; A feature map travels as (values c h w).
(define (fm-v f) (list-ref f 0))
(define (fm-c f) (list-ref f 1))
(define (fm-h f) (list-ref f 2))
(define (fm-w f) (list-ref f 3))

; ─── oblivious primitives, whole-vector ─────────────────────────────────────
; Muxes rather than `if`: `(if (> z 0) z 0)` on a share REVEALS the condition
; bit (§6.3), which here would leak the sign of every pre-activation. These
; forms are branch-free, so they leak nothing; on public values they compute
; exactly the same thing with the mask bound to 1 or 0.

; The fused ReLU∘rescale the hybrid pipeline implements: `v >= 0 ? v >> s : 0`,
; over a whole layer. Spelled out it would be
;
;   (vmul (vashr xs s) (vge xs (vrep 0 (length xs))))
;
; which computes the same thing and is what this file used to say — but it fixes
; the protocol: a bit decomposition plus a batched multiply. `vrelu` is the same
; function with the protocol left to the backend, so `--nonlin gc` makes the
; whole layer's nonlinearity ONE garble round. That is the primitive the 268 ms
; Rust pipeline rests on, and it is why this is a builtin and not a definition.
(define (vrelu-rescale xs s) (vrelu xs s))

; ─── convolution: a sum of scaled strided views ─────────────────────────────
; The taps are enumerated in (ic, ky, kx) order — the order a kernel row is
; stored in — so tap i pairs with kernel element i without a lookup table.
(define (conv-views v in-c ih iw k oh ow)
  (let ((acc (quote ()))
        (hw (* ih iw)))
    (do ((ic (- in-c 1) (- ic 1))) ((< ic 0) acc)
      (do ((ky (- k 1) (- ky 1))) ((< ky 0))
        (do ((kx (- k 1) (- kx 1))) ((< kx 0))
          (set! acc
                (cons (vslice v (+ (* ic hw) (+ (* ky iw) kx)) oh ow iw 1)
                      acc)))))))

; One output channel: sum_t weight[t] * view[t], plus the pre-shifted bias.
(define (conv-channel views kern n b)
  (let loop ((vs views) (ws kern) (acc (vrep b n)))
    (if (null? vs)
        acc
        (loop (cdr vs) (cdr ws) (vadd acc (vscale (car vs) (car ws)))))))

; conv → fused ReLU∘rescale over the WHOLE layer (not per channel), so the
; nonlinearity costs three rounds for the layer rather than three per channel.
(define (conv2d v in-c ih iw kernels cbias k s)
  (let* ((oh (+ (- ih k) 1))
         (ow (+ (- iw k) 1))
         (n (* oh ow))
         (views (conv-views v in-c ih iw k oh ow)))
    (let loop ((ks kernels) (bs cbias) (acc (quote ())))
      (if (null? ks)
          (list (vrelu-rescale acc s) (length kernels) oh ow)
          (loop (cdr ks) (cdr bs)
                (append acc
                        (conv-channel views (car ks) n (ash-left (car bs) s))))))))

; ─── 2x2 max-pool, stride 2 ─────────────────────────────────────────────────
; The four pooling phases are four strided views (column stride 2, row stride
; 2*iw), so the whole layer pools in two levels of `vmax` — four rounds — rather
; than three comparisons per window.
;
; `ash-right` and not `/` for the geometry: this language's `/` is EXACT integer
; division and refuses a remainder, but pooling floors — an 11-wide input pools
; to 5, not to an error. Matches gadgets::maxpool2d_ref: (in - 2) / 2 + 1.
(define (maxpool f)
  (let* ((v (fm-v f)) (c (fm-c f)) (ih (fm-h f)) (iw (fm-w f))
         (oh (+ (ash-right (- ih 2) 1) 1))
         (ow (+ (ash-right (- iw 2) 1) 1))
         (hw (* ih iw))
         (rs (* 2 iw)))
    (let loop ((ch 0) (p00 (quote ())) (p01 (quote ()))
                      (p10 (quote ())) (p11 (quote ())))
      (if (== ch c)
          (list (vmax (vmax p00 p01) (vmax p10 p11)) c oh ow)
          (let ((base (* ch hw)))
            (loop (+ ch 1)
                  (append p00 (vslice v base                oh ow rs 2))
                  (append p01 (vslice v (+ base 1)          oh ow rs 2))
                  (append p10 (vslice v (+ base iw)         oh ow rs 2))
                  (append p11 (vslice v (+ base (+ iw 1))   oh ow rs 2))))))))

; ─── dense layers ───────────────────────────────────────────────────────────
; `matvec` dispatches to a batched precompile when both operands are shares, and
; is local when the weights are public — either way one call, not one per weight.
; The conv bias is pre-shifted (`cbias << s`) and the dense bias is not; that
; asymmetry is the trained model's, and CnnModel::forward_logits has it too.
(define (hidden-layer x l s)
  (vrelu-rescale (vadd (matvec (dense-w l) x) (dense-b l)) s))

; First maximum wins, matching gadgets::argmax_ref — a strict `>` never moves
; off an earlier equal candidate. The index is carried as a value, so when the
; logits are shares the index is a share too and only its reconstruction reveals
; the class. Left fold, not a tournament: this runs over `nclasses` (2 to 11)
; elements once per diagnosis, so its rounds are noise next to a conv layer's.
(define (argmax xs)
  (let ((n (length xs)))
    (let loop ((i 1) (bi 0) (bv (car xs)))
      (if (== i n)
          bi
          (let* ((v (list-ref xs i))
                 (c (> v bv)))
            (loop (+ i 1)
                  (+ (* c i) (* (- 1 c) bi))
                  (+ (* c v) (* (- 1 c) bv))))))))

; ─── the forward pass ───────────────────────────────────────────────────────
; conv → ReLU∘rescale → pool, once per conv layer; then the hidden dense stack;
; then the output layer, whose logits are NOT rescaled (the argmax only needs
; their order).
(define (forward m img)
  (let* ((s (model-shift m))
         (c1 (model-conv1 m))
         (p (maxpool (conv2d img (model-in-c m) (model-d m) (model-d m)
                             (conv-kernels c1) (conv-bias c1) (conv-k c1) s))))
    ; every additional conv is just another conv + nonlinearity + pool
    (let loop ((xs (model-extra m)) (f p))
      (if (null? xs)
          (let dloop ((hs (model-hidden m)) (x (fm-v f)))
            (if (null? hs)
                (argmax (vadd (matvec (model-dense-w m) x) (model-dense-b m)))
                (dloop (cdr hs) (hidden-layer x (car hs) s))))
          (let ((cl (car xs)))
            (loop (cdr xs)
                  (maxpool (conv2d (fm-v f) (xconv-in-c cl)
                                   (xconv-in-h cl) (xconv-in-w cl)
                                   (xconv-kernels cl) (xconv-bias cl)
                                   (xconv-k cl) s))))))))

; ─── privacy: the only place the backend is chosen ──────────────────────────
(define WIDTH (model-nbits (medmnist-model DATASET)))

(define (share-list xs)
  (let loop ((ys xs) (acc (quote ())))
    (if (null? ys)
        (reverse acc)
        (loop (cdr ys) (cons (share (car ys) WIDTH) acc)))))

(define (share-rows rs)
  (let loop ((ys rs) (acc (quote ())))
    (if (null? ys)
        (reverse acc)
        (loop (cdr ys) (cons (share-list (car ys)) acc)))))

; PRIVATE 0 → plaintext; 1 or 2 → the image is secret-shared.
(define (load-input pixels)
  (if (== PRIVATE 0) pixels (share-list pixels)))

; PRIVATE 2 additionally shares every weight, so the model is hidden too.
(define (load-model name)
  (let ((m (medmnist-model name)))
    (if (< PRIVATE 2)
        m
        (list (model-d m) (model-in-c m) (model-shift m) (model-nclasses m)
              (let ((c (model-conv1 m)))
                (list (share-rows (conv-kernels c)) (share-list (conv-bias c)) (conv-k c)))
              (let xloop ((xs (model-extra m)) (acc (quote ())))
                (if (null? xs)
                    (reverse acc)
                    (let ((c (car xs)))
                      (xloop (cdr xs)
                             (cons (list (share-rows (xconv-kernels c))
                                         (share-list (xconv-bias c))
                                         (xconv-in-c c) (xconv-in-h c) (xconv-in-w c)
                                         (xconv-k c))
                                   acc)))))
              (let hloop ((hs (model-hidden m)) (acc (quote ())))
                (if (null? hs)
                    (reverse acc)
                    (let ((l (car hs)))
                      (hloop (cdr hs)
                             (cons (list (share-rows (dense-w l)) (share-list (dense-b l)))
                                   acc)))))
              (share-rows (model-dense-w m))
              (share-list (model-dense-b m))))))

; ─── driver: classify NIMAGES images, count agreements with the true label ───
; `reconstruct` is called on the argmax and nowhere else, so the class index is
; the only value revealed — the logits, the activations and (at PRIVATE 2) the
; weights all stay secret.
(define MODEL (load-model DATASET))

(let loop ((i 0) (correct 0))
  (if (== i NIMAGES)
      (list correct NIMAGES)
      (let* ((rec (medmnist-image DATASET i))
             (img (load-input (list-ref rec 0)))
             (label (list-ref rec 1))
             (cls (reconstruct (forward MODEL img))))
        (loop (+ i 1) (+ correct (if (== cls label) 1 0))))))
